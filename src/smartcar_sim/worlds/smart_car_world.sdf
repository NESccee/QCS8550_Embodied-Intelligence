        </visual>
      </link>
    </model>

    <!-- ==================== 6. 专业实验设施：重型仓储货架与零件箱 ==================== -->
    <model name="industrial_storage_shelving">
      <static>true</static>
      <pose>0.0 2.75 0 0 0 0</pose>
      <link name="link">
        <collision name="shelf_c">
          <pose>0 0 0.65 0 0 0</pose>
          <geometry><box><size>1.30 0.45 1.30</size></box></geometry>
        </collision>
        <!-- 货架立柱与层板 (冷轧钢蓝) -->
        <visual name="shelf_frame">
          <pose>0 0 0.65 0 0 0</pose>
          <geometry><box><size>1.30 0.45 1.30</size></box></geometry>
          <material>
            <ambient>0.15 0.25 0.45 1</ambient>
            <diffuse>0.22 0.38 0.68 1</diffuse>
          </material>
        </visual>
        <!-- 第一层蓝色收纳箱 -->
        <visual name="bin_blue">
          <pose>-0.35 0 0.45 0 0 0</pose>
          <geometry><box><size>0.32 0.38 0.22</size></box></geometry>
          <material>
            <ambient>0.10 0.30 0.75 1</ambient>
            <diffuse>0.15 0.45 0.95 1</diffuse>
          </material>
        </visual>
        <!-- 第二层黄色警戒箱 -->
        <visual name="bin_yellow">
          <pose>0.35 0 0.45 0 0 0</pose>
          <geometry><box><size>0.32 0.38 0.22</size></box></geometry>
          <material>
            <ambient>0.80 0.65 0.05 1</ambient>
            <diffuse>0.96 0.78 0.10 1</diffuse>
