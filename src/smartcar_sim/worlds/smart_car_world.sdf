          <material>
            <ambient>0.18 0.20 0.22 1</ambient>
            <diffuse>0.28 0.30 0.34 1</diffuse>
          </material>
        </visual>
        <!-- AprilTag / ArUco 视觉对准黑白靶标面 -->
        <visual name="dock_target">
          <pose>0.091 0 0.32 0 0 0</pose>
          <geometry><box><size>0.002 0.22 0.22</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
