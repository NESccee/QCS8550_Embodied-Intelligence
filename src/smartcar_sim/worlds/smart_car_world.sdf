          <material>
            <ambient>0.12 0.14 0.16 1</ambient>
            <diffuse>0.18 0.20 0.22 1</diffuse>
          </material>
        </visual>
        <visual name="v_part_m">
          <pose>1.35 0.85 0.465 0 0 0</pose>
          <geometry><box><size>1.5 0.16 0.77</size></box></geometry>
          <material>
            <ambient>0.58 0.60 0.64 1</ambient>
            <diffuse>0.74 0.76 0.80 1</diffuse>
          </material>
        </visual>

        <!-- 东门洞金属门框立柱与门楣 (东门洞: x: 2.1 ~ 3.3，净宽 1.2m) -->
        <visual name="door2_jamb_left">
          <pose>2.10 0.85 0.425 0 0 0</pose>
          <geometry><box><size>0.06 0.20 0.85</size></box></geometry>
          <material>
            <ambient>0.15 0.16 0.18 1</ambient>
            <diffuse>0.24 0.26 0.30 1</diffuse>
          </material>
        </visual>
        <visual name="door2_jamb_right">
          <pose>3.30 0.85 0.425 0 0 0</pose>
          <geometry><box><size>0.06 0.20 0.85</size></box></geometry>
          <material>
            <ambient>0.15 0.16 0.18 1</ambient>
