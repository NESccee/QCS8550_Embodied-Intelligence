          </material>
        </visual>

        <!-- 东侧隔墙段 (x: 3.3 ~ 6.5) -->
        <collision name="c_part_e">
          <pose>4.9 0.85 0.425 0 0 0</pose>
          <geometry><box><size>3.2 0.16 0.85</size></box></geometry>
        </collision>
        <visual name="v_part_e_skirt">
          <pose>4.9 0.85 0.04 0 0 0</pose>
          <geometry><box><size>3.2 0.18 0.08</size></box></geometry>
          <material>
            <ambient>0.12 0.14 0.16 1</ambient>
