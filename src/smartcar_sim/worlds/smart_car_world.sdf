          <material>
            <ambient>0.05 0.85 0.15 1</ambient>
            <diffuse>0.10 0.98 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 8. 室内安全与环境细节 (灭火器、安全出口灯、绿植) ==================== -->
    <!-- 墙挂式红色干粉灭火器 -->
