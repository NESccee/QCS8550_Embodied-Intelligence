    <!-- ==================== 4. 专业实验设施：地面主控工作站 ==================== -->
    <model name="ground_control_station">
      <static>true</static>
      <pose>-1.6 2.45 0 0 0 0</pose>
      <link name="link">
        <!-- 桌子碰撞 -->
        <collision name="table_c">
          <pose>0 0 0.36 0 0 0</pose>
          <geometry><box><size>1.2 0.65 0.72</size></box></geometry>
        </collision>
        <!-- 钢木实验桌桌面 -->
        <visual name="table_top">
          <pose>0 0 0.71 0 0 0</pose>
          <geometry><box><size>1.2 0.65 0.03</size></box></geometry>
          <material>
            <ambient>0.70 0.72 0.75 1</ambient>
            <diffuse>0.88 0.90 0.92 1</diffuse>
          </material>
        </visual>
        <!-- 黑色钢质桌腿 -->
        <visual name="table_legs">
          <pose>0 0 0.35 0 0 0</pose>
          <geometry><box><size>1.14 0.59 0.70</size></box></geometry>
          <material>
            <ambient>0.12 0.12 0.14 1</ambient>
            <diffuse>0.18 0.18 0.22 1</diffuse>
          </material>
        </visual>
        <!-- 双联液晶显示器 (左主屏) -->
        <visual name="monitor_left">
          <pose>-0.22 -0.10 0.92 0 0 0.15</pose>
          <geometry><box><size>0.42 0.02 0.26</size></box></geometry>
          <material>
            <ambient>0.08 0.15 0.28 1</ambient>
            <diffuse>0.15 0.32 0.55 1</diffuse>
          </material>
        </visual>
        <!-- 双联液晶显示器 (右副屏) -->
        <visual name="monitor_right">
          <pose>0.22 -0.10 0.92 0 0 -0.15</pose>
          <geometry><box><size>0.42 0.02 0.26</size></box></geometry>
          <material>
            <ambient>0.08 0.15 0.28 1</ambient>
            <diffuse>0.15 0.32 0.55 1</diffuse>
          </material>
        </visual>
        <!-- 工控塔式主机 -->
        <visual name="pc_tower">
          <pose>0.48 0.05 0.22 0 0 0</pose>
          <geometry><box><size>0.18 0.40 0.42</size></box></geometry>
          <material>
            <ambient>0.10 0.10 0.10 1</ambient>
            <diffuse>0.15 0.15 0.18 1</diffuse>
          </material>
        </visual>
        <!-- 主机电源指示灯 (蓝色常亮) -->
        <visual name="pc_led">
          <pose>0.48 -0.16 0.38 0 0 0</pose>
          <geometry><box><size>0.01 0.01 0.01</size></box></geometry>
          <material>
            <ambient>0.1 0.4 0.9 1</ambient>
            <diffuse>0.2 0.6 1.0 1</diffuse>
          </material>
        </visual>
        <!-- 办公人体工学网布转椅 -->
        <visual name="chair_seat">
          <pose>0 -0.45 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.22</radius><length>0.08</length></cylinder></geometry>
          <material>
            <ambient>0.12 0.12 0.14 1</ambient>
            <diffuse>0.18 0.18 0.20 1</diffuse>
          </material>
        </visual>
        <visual name="chair_back">
          <pose>0 -0.62 0.72 0.1 0 0</pose>
          <geometry><box><size>0.38 0.05 0.44</size></box></geometry>
          <material>
            <ambient>0.10 0.10 0.12 1</ambient>
            <diffuse>0.15 0.15 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 5. 专业实验设施：19寸标准网络与算力服务器机柜 ==================== -->
    <model name="server_telemetry_rack">
      <static>true</static>
      <pose>5.8 2.35 0 0 0 0</pose>
      <link name="link">
        <collision name="rack_c">
          <pose>0 0 0.65 0 0 0</pose>
          <geometry><box><size>0.60 0.65 1.30</size></box></geometry>
        </collision>
        <!-- 机柜主体 (黑色钣金) -->
        <visual name="rack_body">
