    <!-- ==================== 7. 自主充电基座与视觉对准靶标 (Docking Station) ==================== -->
    <model name="charging_dock_station">
      <static>true</static>
      <pose>-0.60 0.0 0 0 0 0</pose>
      <link name="link">
        <collision name="dock_c">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>0.25 0.35 0.50</size></box></geometry>
        </collision>
        <!-- 充电桩立柱 -->
        <visual name="dock_post">
