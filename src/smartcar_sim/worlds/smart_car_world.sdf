<?xml version="1.0" ?>
<!--
  高保真真实室内自主机器人综合实验场地 (Realistic AMR Testing Facility - SDF 1.8)
  根据真实室内机器人实验室与 AMR 测试环境标准规范建模：
    1. 真实建筑与地面：高光泽工业环氧地坪、地面安全警戒带、门禁铝合金门套结构、全墙体踢脚线
    2. 专业实验设施与家具：
       - 地面主控工作站 (双联大屏显示器、主机、键盘、办公椅)
       - 19寸标准服务器与网络遥测机柜 (含服务器机身与状态指示灯)
       - 重型工业仓储货架 (含分色零件收纳盒、仪器箱、纸箱)
       - 智能自主快充对准桩 (充电基座、导引槽、AprilTag 视觉对准靶标)
       - 实验室消防灭火器、绿色发光安全出口指示牌、现代室内绿植盆栽
    3. 多传感器 SLAM 验证要素：
       - 走廊直道 (退化检测与 IMU 预积分)
       - 多分区房间与双向门洞 (因子图回环检测与全局/局部路径规划)
       - 丰富语义目标 (仿真人体、反光条警示桶、重型木质包装箱)
    4. 采用世界视角 (World Perspective) 全景摄像机配置，全局纵览小车运行姿态
-->
<sdf version="1.8">
  <world name="smart_car_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>

    <!-- GUI 世界视角全景摄像机 (俯瞰整个实验场地：走廊、双门洞与室内测试区) -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>2.0 -4.6 5.2 0.0 0.82 1.5708</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- 主太阳光 (模拟天窗/斜射光，提供清晰接触阴影与立体感) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.82 0.84 0.86 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.35 0.25 -0.85</direction>
    </light>

    <!-- 实验室顶部吊顶多点漫射补光 (消除深暗死角) -->
    <light type="directional" name="ceiling_fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.40 0.42 0.46 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.35 -0.25 -0.85</direction>
    </light>

    <!-- ==================== 1. 真实实验室地面与地标标线 ==================== -->
    <model name="laboratory_floor">
      <static>true</static>
      <link name="link">
        <!-- 主环氧地坪 -->
        <collision name="floor_collision">
          <geometry><plane><normal>0 0 1</normal><size>28 22</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="floor_visual">
          <geometry><plane><normal>0 0 1</normal><size>28 22</size></plane></geometry>
          <material>
            <ambient>0.32 0.35 0.38 1</ambient>
            <diffuse>0.44 0.47 0.51 1</diffuse>
          </material>
        </visual>

        <!-- 走廊南侧安全警示黄线 (宽 8cm) -->
        <visual name="safety_line_south">
          <pose>2.0 -1.45 0.001 0 0 0</pose>
          <geometry><box><size>8.8 0.08 0.001</size></box></geometry>
          <material>
            <ambient>0.80 0.65 0.05 1</ambient>
            <diffuse>0.96 0.78 0.10 1</diffuse>
          </material>
        </visual>
        <!-- 房间北侧安全警示黄线 -->
        <visual name="safety_line_north">
          <pose>2.0 3.05 0.001 0 0 0</pose>
          <geometry><box><size>8.8 0.08 0.001</size></box></geometry>
          <material>
            <ambient>0.80 0.65 0.05 1</ambient>
            <diffuse>0.96 0.78 0.10 1</diffuse>
          </material>
        </visual>
        <!-- 巡航回路引导白虚线 (走廊段) -->
        <visual name="lane_guide_corridor">
          <pose>1.3 0.0 0.001 0 0 0</pose>
          <geometry><box><size>2.6 0.05 0.001</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
        <!-- 巡航回路引导白虚线 (北区返程段) -->
        <visual name="lane_guide_room">
          <pose>1.3 1.6 0.001 0 0 0</pose>
          <geometry><box><size>2.6 0.05 0.001</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
        <!-- 小车自主充电待机停机位 (黄色边框停车位) -->
        <visual name="docking_pad_border">
          <pose>-0.05 0.0 0.001 0 0 0</pose>
          <geometry><box><size>0.45 0.35 0.001</size></box></geometry>
          <material>
            <ambient>0.25 0.28 0.30 1</ambient>
            <diffuse>0.35 0.38 0.42 1</diffuse>
          </material>
        </visual>
        <visual name="docking_pad_line_f">
          <pose>0.17 0.0 0.002 0 0 0</pose>
          <geometry><box><size>0.02 0.35 0.001</size></box></geometry>
          <material>
            <ambient>0.80 0.65 0.05 1</ambient>
            <diffuse>0.96 0.78 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 2. 真实建筑外墙体 (含黑色踢脚线) ==================== -->
    <model name="outer_walls_with_skirting">
      <static>true</static>
      <link name="link">
        <!-- 南侧主外墙 (含踢脚线与浅灰墙体) -->
        <collision name="c_south">
          <pose>2.0 -1.6 0.425 0 0 0</pose>
          <geometry><box><size>9.0 0.16 0.85</size></box></geometry>
        </collision>
        <visual name="v_south_skirt">
          <pose>2.0 -1.59 0.04 0 0 0</pose>
          <geometry><box><size>9.0 0.18 0.08</size></box></geometry>
          <material>
            <ambient>0.12 0.14 0.16 1</ambient>
            <diffuse>0.18 0.20 0.22 1</diffuse>
          </material>
        </visual>
        <visual name="v_south_wall">
          <pose>2.0 -1.6 0.465 0 0 0</pose>
          <geometry><box><size>9.0 0.16 0.77</size></box></geometry>
          <material>
            <ambient>0.62 0.65 0.68 1</ambient>
            <diffuse>0.78 0.80 0.84 1</diffuse>
          </material>
        </visual>

        <!-- 北侧主外墙 -->
        <collision name="c_north">
          <pose>2.0 3.2 0.425 0 0 0</pose>
          <geometry><box><size>9.0 0.16 0.85</size></box></geometry>
        </collision>
        <visual name="v_north_skirt">
          <pose>2.0 3.19 0.04 0 0 0</pose>
          <geometry><box><size>9.0 0.18 0.08</size></box></geometry>
          <material>
            <ambient>0.12 0.14 0.16 1</ambient>
            <diffuse>0.18 0.20 0.22 1</diffuse>
          </material>
        </visual>
        <visual name="v_north_wall">
          <pose>2.0 3.2 0.465 0 0 0</pose>
          <geometry><box><size>9.0 0.16 0.77</size></box></geometry>
          <material>
            <ambient>0.62 0.65 0.68 1</ambient>
            <diffuse>0.78 0.80 0.84 1</diffuse>
          </material>
        </visual>

        <!-- 西侧外墙 -->
        <collision name="c_west">
          <pose>-2.5 0.8 0.425 0 0 0</pose>
          <geometry><box><size>0.16 4.96 0.85</size></box></geometry>
        </collision>
        <visual name="v_west_skirt">
          <pose>-2.49 0.8 0.04 0 0 0</pose>
          <geometry><box><size>0.18 4.96 0.08</size></box></geometry>
          <material>
            <ambient>0.12 0.14 0.16 1</ambient>
            <diffuse>0.18 0.20 0.22 1</diffuse>
          </material>
        </visual>
        <visual name="v_west_wall">
          <pose>-2.5 0.8 0.465 0 0 0</pose>
          <geometry><box><size>0.16 4.96 0.77</size></box></geometry>
          <material>
            <ambient>0.62 0.65 0.68 1</ambient>
            <diffuse>0.78 0.80 0.84 1</diffuse>
          </material>
        </visual>

        <!-- 东侧外墙 -->
        <collision name="c_east">
          <pose>6.5 0.8 0.425 0 0 0</pose>
          <geometry><box><size>0.16 4.96 0.85</size></box></geometry>
        </collision>
        <visual name="v_east_skirt">
          <pose>6.49 0.8 0.04 0 0 0</pose>
          <geometry><box><size>0.18 4.96 0.08</size></box></geometry>
          <material>
            <ambient>0.12 0.14 0.16 1</ambient>
            <diffuse>0.18 0.20 0.22 1</diffuse>
          </material>
        </visual>
        <visual name="v_east_wall">
          <pose>6.5 0.8 0.465 0 0 0</pose>
          <geometry><box><size>0.16 4.96 0.77</size></box></geometry>
          <material>
            <ambient>0.62 0.65 0.68 1</ambient>
            <diffuse>0.78 0.80 0.84 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 3. 室内功能区分割墙体与金属铝合金门套 (门洞 1.2m) ==================== -->
    <model name="interior_partitions_and_portals">
      <static>true</static>
      <link name="link">
        <!-- 西侧隔墙段 (x: -2.5 ~ -0.6) -->
        <collision name="c_part_w">
          <pose>-1.55 0.85 0.425 0 0 0</pose>
          <geometry><box><size>1.9 0.16 0.85</size></box></geometry>
        </collision>
        <visual name="v_part_w_skirt">
          <pose>-1.55 0.85 0.04 0 0 0</pose>
          <geometry><box><size>1.9 0.18 0.08</size></box></geometry>
          <material>
            <ambient>0.12 0.14 0.16 1</ambient>
            <diffuse>0.18 0.20 0.22 1</diffuse>
          </material>
        </visual>
        <visual name="v_part_w">
          <pose>-1.55 0.85 0.465 0 0 0</pose>
          <geometry><box><size>1.9 0.16 0.77</size></box></geometry>
          <material>
            <ambient>0.58 0.60 0.64 1</ambient>
            <diffuse>0.74 0.76 0.80 1</diffuse>
          </material>
        </visual>

        <!-- 西门洞金属门框立柱与门楣 (西门洞: x: -0.6 ~ 0.6，净宽 1.2m) -->
        <visual name="door1_jamb_left">
          <pose>-0.60 0.85 0.425 0 0 0</pose>
          <geometry><box><size>0.06 0.20 0.85</size></box></geometry>
          <material>
            <ambient>0.15 0.16 0.18 1</ambient>
            <diffuse>0.24 0.26 0.30 1</diffuse>
          </material>
        </visual>
        <visual name="door1_jamb_right">
          <pose>0.60 0.85 0.425 0 0 0</pose>
          <geometry><box><size>0.06 0.20 0.85</size></box></geometry>
          <material>
            <ambient>0.15 0.16 0.18 1</ambient>
            <diffuse>0.24 0.26 0.30 1</diffuse>
          </material>
        </visual>
        <visual name="door1_header">
          <pose>0.0 0.85 0.83 0 0 0</pose>
          <geometry><box><size>1.26 0.18 0.04</size></box></geometry>
          <material>
            <ambient>0.15 0.16 0.18 1</ambient>
            <diffuse>0.24 0.26 0.30 1</diffuse>
          </material>
        </visual>

        <!-- 中部隔墙段 (x: 0.6 ~ 2.1) -->
        <collision name="c_part_m">
          <pose>1.35 0.85 0.425 0 0 0</pose>
