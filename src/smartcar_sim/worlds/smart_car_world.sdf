        <!-- 内部服务器状态绿灯群 (阵列指示) -->
        <visual name="rack_led_1">
          <pose>-0.29 0.15 0.85 0 0 0</pose>
          <geometry><box><size>0.01 0.01 0.01</size></box></geometry>
          <material>
            <ambient>0.05 0.80 0.15 1</ambient>
            <diffuse>0.10 0.98 0.25 1</diffuse>
          </material>
        </visual>
        <visual name="rack_led_2">
          <pose>-0.29 0.15 0.75 0 0 0</pose>
          <geometry><box><size>0.01 0.01 0.01</size></box></geometry>
          <material>
            <ambient>0.05 0.80 0.15 1</ambient>
            <diffuse>0.10 0.98 0.25 1</diffuse>
          </material>
        </visual>
        <visual name="rack_led_3">
          <pose>-0.29 0.15 0.65 0 0 0</pose>
          <geometry><box><size>0.01 0.01 0.01</size></box></geometry>
          <material>
            <ambient>0.80 0.70 0.05 1</ambient>
