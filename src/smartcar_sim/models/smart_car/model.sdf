    </link>

    <!-- 右前轮 -->
    <link name="right_front_wheel">
      <pose>0.07 -0.085 0.0325 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>9.13e-06</ixx><iyy>9.13e-06</iyy><izz>1.58e-05</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.0325</radius><length>0.022</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="tire_tread">
        <geometry><cylinder><radius>0.0325</radius><length>0.022</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.16 0.16 0.16 1</diffuse>
        </material>
      </visual>
      <visual name="wheel_rim">
        <pose>0 0 -0.002 0 0 0</pose>
        <geometry><cylinder><radius>0.022</radius><length>0.020</length></cylinder></geometry>
        <material>
          <ambient>0.45 0.48 0.52 1</ambient>
          <diffuse>0.65 0.68 0.72 1</diffuse>
        </material>
      </visual>
      <visual name="beadlock_ring">
        <pose>0 0 -0.0105 0 0 0</pose>
        <geometry><cylinder><radius>0.0235</radius><length>0.002</length></cylinder></geometry>
        <material>
          <ambient>0.80 0.38 0.05 1</ambient>
          <diffuse>0.98 0.50 0.08 1</diffuse>
        </material>
      </visual>
      <visual name="center_hub">
        <pose>0 0 -0.012 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.003</length></cylinder></geometry>
        <material>
          <ambient>0.70 0.70 0.70 1</ambient>
          <diffuse>0.88 0.88 0.88 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 右后轮 -->
    <link name="right_rear_wheel">
      <pose>-0.07 -0.085 0.0325 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>9.13e-06</ixx><iyy>9.13e-06</iyy><izz>1.58e-05</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.0325</radius><length>0.022</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="tire_tread">
        <geometry><cylinder><radius>0.0325</radius><length>0.022</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.16 0.16 0.16 1</diffuse>
        </material>
      </visual>
      <visual name="wheel_rim">
        <pose>0 0 -0.002 0 0 0</pose>
        <geometry><cylinder><radius>0.022</radius><length>0.020</length></cylinder></geometry>
        <material>
          <ambient>0.45 0.48 0.52 1</ambient>
          <diffuse>0.65 0.68 0.72 1</diffuse>
        </material>
      </visual>
      <visual name="beadlock_ring">
        <pose>0 0 -0.0105 0 0 0</pose>
        <geometry><cylinder><radius>0.0235</radius><length>0.002</length></cylinder></geometry>
        <material>
          <ambient>0.80 0.38 0.05 1</ambient>
          <diffuse>0.98 0.50 0.08 1</diffuse>
        </material>
      </visual>
      <visual name="center_hub">
        <pose>0 0 -0.012 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.003</length></cylinder></geometry>
        <material>
          <ambient>0.70 0.70 0.70 1</ambient>
          <diffuse>0.88 0.88 0.88 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 关节定义 -->
    <joint name="left_front_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_front_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>5</effort><velocity>20</velocity></limit>
      </axis>
    </joint>

    <joint name="left_rear_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_rear_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>5</effort><velocity>20</velocity></limit>
      </axis>
    </joint>

    <joint name="right_front_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_front_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>5</effort><velocity>20</velocity></limit>
      </axis>
    </joint>

    <joint name="right_rear_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_rear_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>5</effort><velocity>20</velocity></limit>
      </axis>
    </joint>

    <!-- 差速驱动插件 -->
    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_front_wheel_joint</left_joint>
      <left_joint>left_rear_wheel_joint</left_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      <right_joint>right_rear_wheel_joint</right_joint>
      <wheel_separation>0.17</wheel_separation>
      <wheel_radius>0.0325</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <max_linear_velocity>1.5</max_linear_velocity>
      <max_angular_velocity>4.0</max_angular_velocity>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>/model/smart_car/cmd_vel</topic>
      <odom_topic>/model/smart_car/odometry</odom_topic>
      <tf_topic>/model/smart_car/tf</tf_topic>
    </plugin>

    <!-- 关节状态发布插件 -->
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/world/smart_car_world/model/smart_car/joint_state</topic>
    </plugin>
  </model>
</sdf>
