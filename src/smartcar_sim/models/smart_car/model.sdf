<?xml version="1.0" ?>
<!--
  高保真工业级自主移动机器人 (AMR / UGV) 仿真模型 (Ignition Fortress / SDF 1.8)
  特点：
    1. 真实工控车体：低重心模块化铝合金底盘、前后防撞钢梁/保险杠、高亮双 LED 大灯与红光尾灯
    2. 顶级传感器塔架：多层 T 型铝型材支柱、车载高算力工控机 (NVIDIA Jetson AGX 造型带散热鳍片)
    3. 3D 激光雷达总成：类 Velodyne VLP-16 / RoboSense 结构，含深色光学透镜圈、散热底座与防护顶盖
    4. RGB-D 双目深度相机：类 Intel RealSense D435i 结构，含双红外镜头、RGB 镜头与红外投射器
    5. 全地形轮组：深花纹橡胶外胎 + CNC 铝合金轮毂 + 阳极氧化防脱点缀圈与中心轴盖
    6. 工业安全细节：后甲板红色急停 (E-Stop) 蘑菇头按钮、双高增益全向天线、侧防护散热格栅
    7. 传感器集成：200 Hz 6-DOF IMU 惯性测量单元、差速里程计与关节状态发布
-->
<sdf version="1.8">
  <model name="smart_car">
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="base_link">
      <pose>0 0 0.06 0 0 0</pose>
      <inertial>
        <mass>1.08</mass>
        <inertia>
          <ixx>0.0032</ixx>
          <iyy>0.0048</iyy>
          <izz>0.0062</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- 1. 物理底盘碰撞体 (保持平整避障) -->
      <collision name="base_collision">
        <geometry><box><size>0.20 0.15 0.06</size></box></geometry>
        <surface><friction><ode><mu>0.3</mu><mu2>0.3</mu2></ode></friction></surface>
      </collision>

      <!-- 2. 主车体下部底盘 (哑光战术灰合金机身) -->
      <visual name="chassis_main_visual">
        <geometry><box><size>0.20 0.145 0.055</size></box></geometry>
        <material>
          <ambient>0.14 0.16 0.18 1</ambient>
          <diffuse>0.22 0.25 0.28 1</diffuse>
        </material>
      </visual>

      <!-- 3. 前部斜切装甲鼻锥 (提升线条感与接近角) -->
      <visual name="chassis_front_wedge">
        <pose>0.09 0 -0.008 0 0.35 0</pose>
        <geometry><box><size>0.055 0.142 0.028</size></box></geometry>
        <material>
          <ambient>0.10 0.12 0.14 1</ambient>
          <diffuse>0.16 0.18 0.20 1</diffuse>
        </material>
      </visual>

      <!-- 4. 前置重型防撞钢梁/保险杠 (Bullbar) -->
      <visual name="front_bullbar_main">
        <pose>0.108 0 -0.005 0 0 0</pose>
        <geometry><box><size>0.016 0.165 0.032</size></box></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="front_skid_plate">
        <pose>0.085 0 -0.026 0 0.15 0</pose>
        <geometry><box><size>0.05 0.11 0.005</size></box></geometry>
        <material>
          <ambient>0.40 0.42 0.45 1</ambient>
          <diffuse>0.55 0.58 0.62 1</diffuse>
        </material>
      </visual>

      <!-- 5. 后置保护杠与牵引座 -->
      <visual name="rear_bumper">
        <pose>-0.106 0 -0.005 0 0 0</pose>
        <geometry><box><size>0.014 0.160 0.030</size></box></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>

      <!-- 6. 左右侧散热进气格栅 -->
      <visual name="left_vent_grille">
        <pose>0 0.074 0.002 0 0 0</pose>
        <geometry><box><size>0.12 0.004 0.035</size></box></geometry>
        <material>
          <ambient>0.06 0.06 0.06 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>
      <visual name="right_vent_grille">
        <pose>0 -0.074 0.002 0 0 0</pose>
        <geometry><box><size>0.12 0.004 0.035</size></box></geometry>
        <material>
          <ambient>0.06 0.06 0.06 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>

      <!-- 7. 车载照明系统：双前高亮 LED 矩阵车灯 -->
      <visual name="headlight_left">
        <pose>0.109 0.052 0.008 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.010</radius><length>0.004</length></cylinder></geometry>
        <material>
          <ambient>0.90 0.92 0.95 1</ambient>
          <diffuse>0.98 0.98 1.0 1</diffuse>
        </material>
      </visual>
      <visual name="headlight_right">
        <pose>0.109 -0.052 0.008 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.010</radius><length>0.004</length></cylinder></geometry>
        <material>
          <ambient>0.90 0.92 0.95 1</ambient>
          <diffuse>0.98 0.98 1.0 1</diffuse>
        </material>
      </visual>

      <!-- 8. 车载尾灯系统：双后置红光状态警示灯 -->
      <visual name="taillight_left">
        <pose>-0.108 0.055 0.008 0 1.5708 0</pose>
        <geometry><box><size>0.004 0.022 0.010</size></box></geometry>
        <material>
          <ambient>0.70 0.05 0.05 1</ambient>
          <diffuse>0.95 0.10 0.10 1</diffuse>
        </material>
      </visual>
      <visual name="taillight_right">
        <pose>-0.108 -0.055 0.008 0 1.5708 0</pose>
        <geometry><box><size>0.004 0.022 0.010</size></box></geometry>
        <material>
          <ambient>0.70 0.05 0.05 1</ambient>
          <diffuse>0.95 0.10 0.10 1</diffuse>
        </material>
      </visual>

      <!-- 9. 顶盖高刚性碳纤维主甲板 -->
      <visual name="carbon_top_plate">
        <pose>0 0 0.030 0 0 0</pose>
        <geometry><box><size>0.185 0.138 0.005</size></box></geometry>
        <material>
          <ambient>0.06 0.06 0.06 1</ambient>
          <diffuse>0.11 0.11 0.12 1</diffuse>
        </material>
      </visual>

      <!-- 10. 工业安全急停 (E-Stop) 按钮 (红蘑菇头 + 黄底座) -->
      <visual name="estop_base">
        <pose>-0.065 -0.045 0.035 0 0 0</pose>
        <geometry><cylinder><radius>0.010</radius><length>0.006</length></cylinder></geometry>
        <material>
          <ambient>0.80 0.70 0.05 1</ambient>
          <diffuse>0.95 0.85 0.10 1</diffuse>
        </material>
      </visual>
      <visual name="estop_mushroom">
        <pose>-0.065 -0.045 0.042 0 0 0</pose>
        <geometry><cylinder><radius>0.011</radius><length>0.008</length></cylinder></geometry>
        <material>
          <ambient>0.75 0.05 0.05 1</ambient>
          <diffuse>0.95 0.10 0.10 1</diffuse>
        </material>
      </visual>

      <!-- 11. 双全向天线系统 (Wi-Fi 6 / RTK GNSS) -->
      <visual name="antenna_left">
        <pose>-0.082 0.052 0.065 0 0 0</pose>
        <geometry><cylinder><radius>0.003</radius><length>0.065</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>
      </visual>
      <visual name="antenna_right">
        <pose>-0.082 -0.052 0.050 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.035</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>
      </visual>

      <!-- 12. 车载工控计算平台 (NVIDIA Jetson AGX 造型机箱) -->
      <visual name="ipc_chassis">
        <pose>-0.015 0 0.050 0 0 0</pose>
        <geometry><box><size>0.082 0.086 0.032</size></box></geometry>
        <material>
          <ambient>0.20 0.22 0.25 1</ambient>
          <diffuse>0.32 0.35 0.40 1</diffuse>
        </material>
      </visual>
      <visual name="ipc_heatsink_fins">
        <pose>-0.015 0 0.068 0 0 0</pose>
        <geometry><box><size>0.076 0.080 0.006</size></box></geometry>
        <material>
          <ambient>0.12 0.12 0.14 1</ambient>
          <diffuse>0.18 0.18 0.22 1</diffuse>
        </material>
      </visual>
      <visual name="ipc_status_led">
        <pose>0.027 0.035 0.056 0 0 0</pose>
        <geometry><box><size>0.003 0.005 0.003</size></box></geometry>
        <material>
          <ambient>0.05 0.80 0.15 1</ambient>
          <diffuse>0.10 0.98 0.25 1</diffuse>
        </material>
      </visual>

      <!-- 13. 传感器塔架双立柱 (T 型黑色阳极氧化铝型材) -->
      <visual name="mast_post_left">
        <pose>0.005 0.038 0.095 0 0 0</pose>
        <geometry><box><size>0.012 0.012 0.090</size></box></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>
      </visual>
      <visual name="mast_post_right">
        <pose>0.005 -0.038 0.095 0 0 0</pose>
        <geometry><box><size>0.012 0.012 0.090</size></box></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>
      </visual>
      <visual name="mast_top_plate">
        <pose>0.005 0 0.141 0 0 0</pose>
        <geometry><box><size>0.068 0.092 0.004</size></box></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.14 0.14 0.14 1</diffuse>
        </material>
      </visual>

      <!-- 14. 3D 多线激光雷达总成 (Velodyne / RoboSense 造型) -->
      <!-- 雷达散热底座 -->
      <visual name="lidar_base">
        <pose>0.005 0 0.153 0 0 0</pose>
        <geometry><cylinder><radius>0.036</radius><length>0.020</length></cylinder></geometry>
        <material>
          <ambient>0.15 0.16 0.18 1</ambient>
          <diffuse>0.24 0.26 0.30 1</diffuse>
        </material>
      </visual>
      <!-- 雷达深色光学透镜视窗 (深蓝/紫色反射光感) -->
      <visual name="lidar_optics">
        <pose>0.005 0 0.170 0 0 0</pose>
        <geometry><cylinder><radius>0.0365</radius><length>0.016</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.08 0.20 1</ambient>
          <diffuse>0.08 0.14 0.38 1</diffuse>
        </material>
      </visual>
      <!-- 雷达防护顶盖与校准标线 -->
      <visual name="lidar_top_cap">
        <pose>0.005 0 0.181 0 0 0</pose>
        <geometry><cylinder><radius>0.036</radius><length>0.006</length></cylinder></geometry>
        <material>
          <ambient>0.15 0.16 0.18 1</ambient>
          <diffuse>0.24 0.26 0.30 1</diffuse>
        </material>
      </visual>
      <collision name="lidar_collision">
        <pose>0.005 0 0.168 0 0 0</pose>
        <geometry><cylinder><radius>0.036</radius><length>0.046</length></cylinder></geometry>
      </collision>

      <!-- 15. 前置高精度 RGB-D 深度相机 (Intel RealSense D435i 造型) -->
      <visual name="camera_bracket">
        <pose>0.088 0 0.030 0 0 0</pose>
        <geometry><box><size>0.020 0.035 0.022</size></box></geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>
      </visual>
      <visual name="camera_body">
        <pose>0.096 0 0.038 0 0.087 0</pose>
        <geometry><box><size>0.020 0.090 0.024</size></box></geometry>
        <material>
          <ambient>0.48 0.52 0.56 1</ambient>
          <diffuse>0.70 0.74 0.78 1</diffuse>
        </material>
      </visual>
      <visual name="camera_front_glass">
        <pose>0.1065 0 0.039 0 0.087 0</pose>
        <geometry><box><size>0.002 0.086 0.020</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.06 1</ambient>
          <diffuse>0.08 0.08 0.10 1</diffuse>
        </material>
      </visual>
      <!-- 左红外镜头 -->
      <visual name="lens_ir_left">
        <pose>0.108 0.028 0.039 0 1.657 0</pose>
        <geometry><cylinder><radius>0.0055</radius><length>0.003</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.02 0.03 1</ambient>
          <diffuse>0.04 0.04 0.06 1</diffuse>
        </material>
      </visual>
      <!-- 右红外镜头 -->
      <visual name="lens_ir_right">
        <pose>0.108 -0.028 0.039 0 1.657 0</pose>
        <geometry><cylinder><radius>0.0055</radius><length>0.003</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.02 0.03 1</ambient>
          <diffuse>0.04 0.04 0.06 1</diffuse>
        </material>
      </visual>
      <!-- 中置 RGB 色彩镜头 -->
      <visual name="lens_rgb">
        <pose>0.108 -0.008 0.039 0 1.657 0</pose>
        <geometry><cylinder><radius>0.0045</radius><length>0.003</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.12 0.05 1</ambient>
          <diffuse>0.10 0.25 0.10 1</diffuse>
        </material>
      </visual>
      <!-- 红外激光散斑投射器 -->
      <visual name="projector_ir">
        <pose>0.108 0.010 0.039 0 1.657 0</pose>
        <geometry><cylinder><radius>0.0040</radius><length>0.003</length></cylinder></geometry>
        <material>
          <ambient>0.15 0.02 0.02 1</ambient>
          <diffuse>0.30 0.05 0.05 1</diffuse>
        </material>
      </visual>
      <collision name="camera_collision">
        <pose>0.096 0 0.038 0 0.087 0</pose>
        <geometry><box><size>0.022 0.090 0.024</size></box></geometry>
      </collision>

      <!-- 16. 6-DOF IMU 惯性传感器 (200 Hz 质心配置) -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>200</update_rate>
        <topic>/model/smart_car/imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- ==================== 四轮组设计 (全地形深花纹外胎 + CNC 铝合金轮毂 + 阳极防脱圈) ==================== -->

    <!-- 左前轮 -->
    <link name="left_front_wheel">
      <pose>0.07 0.085 0.0325 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>9.13e-06</ixx><iyy>9.13e-06</iyy><izz>1.58e-05</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.0325</radius><length>0.022</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <!-- 深花纹橡胶外胎 -->
      <visual name="tire_tread">
        <geometry><cylinder><radius>0.0325</radius><length>0.022</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.16 0.16 0.16 1</diffuse>
        </material>
      </visual>
      <!-- CNC 铝合金轮毂 -->
      <visual name="wheel_rim">
        <pose>0 0 0.002 0 0 0</pose>
        <geometry><cylinder><radius>0.022</radius><length>0.020</length></cylinder></geometry>
        <material>
          <ambient>0.45 0.48 0.52 1</ambient>
          <diffuse>0.65 0.68 0.72 1</diffuse>
        </material>
      </visual>
      <!-- 阳极氧化防脱点缀圈 -->
      <visual name="beadlock_ring">
        <pose>0 0 0.0105 0 0 0</pose>
        <geometry><cylinder><radius>0.0235</radius><length>0.002</length></cylinder></geometry>
        <material>
          <ambient>0.80 0.38 0.05 1</ambient>
          <diffuse>0.98 0.50 0.08 1</diffuse>
        </material>
      </visual>
      <!-- 中心轴盖 -->
      <visual name="center_hub">
        <pose>0 0 0.012 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.003</length></cylinder></geometry>
        <material>
          <ambient>0.70 0.70 0.70 1</ambient>
          <diffuse>0.88 0.88 0.88 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 左后轮 -->
    <link name="left_rear_wheel">
      <pose>-0.07 0.085 0.0325 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>9.13e-06</ixx><iyy>9.13e-06</iyy><izz>1.58e-05</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.0325</radius><length>0.022</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="tire_tread">
        <geometry><cylinder><radius>0.0325</radius><length>0.022</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.16 0.16 0.16 1</diffuse>
        </material>
      </visual>
      <visual name="wheel_rim">
        <pose>0 0 0.002 0 0 0</pose>
        <geometry><cylinder><radius>0.022</radius><length>0.020</length></cylinder></geometry>
        <material>
          <ambient>0.45 0.48 0.52 1</ambient>
          <diffuse>0.65 0.68 0.72 1</diffuse>
        </material>
      </visual>
      <visual name="beadlock_ring">
        <pose>0 0 0.0105 0 0 0</pose>
        <geometry><cylinder><radius>0.0235</radius><length>0.002</length></cylinder></geometry>
        <material>
          <ambient>0.80 0.38 0.05 1</ambient>
          <diffuse>0.98 0.50 0.08 1</diffuse>
        </material>
      </visual>
      <visual name="center_hub">
        <pose>0 0 0.012 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.003</length></cylinder></geometry>
        <material>
          <ambient>0.70 0.70 0.70 1</ambient>
          <diffuse>0.88 0.88 0.88 1</diffuse>
        </material>
